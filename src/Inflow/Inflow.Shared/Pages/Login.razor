@inject IStringLocalizer<LoginPageResources> Localizer

@page "/Login"

<MudThemeProvider @bind-IsDarkMode="@_isDarkMode" Theme="_theme"/>
<MudPopoverProvider />

<MudMainContent id="login-main-content">
    <MudContainer MaxWidth="MaxWidth.Medium">
        <MudGrid 
            id="login-grid"
            Class="d-flex align-center justify-center "
            Style="min-height: 85vh">
            <MudItem xs="12" sm="7">
                <MudPaper Class="pb-10 pr-10 pl-10 pt-2" Style="min-width: 140px">
                    <!-- 
                        The div below is just to push the switch to the right end of the paper.
                        TODO: I'm not sure that it's best practice.
                     -->
                    <div Class="d-flex justify-end">
                        <div></div>
                        <MudSwitch id="theme-switcher" 
                                   @bind-Value="_isDarkMode"
                                   Color="Color.Primary"
                                   T="bool"
                                   Label="@Localizer["Theme"]"/>
                    </div>
                    <MudForm 
                             id="login-form"
                             @ref="_form"
                             @bind-IsValid="@_success"
                             OnEnterPressed="@(() => _form.ValidateAsync())">
                        <MudTextField id="username"
                                      T="string"
                                      Class="mt-6"
                                      Label="@Localizer["Username"]" 
                                      Required="true"
                                      RequiredError="@Localizer["UsernameIsRequired"]"/>
                        <MudTextField id="password" 
                                      T="string"
                                      Class="mt-6"
                                      @bind-Value="@_password"
                                      Label="@Localizer["Password"]"
                                      InputType="InputType.Password"
                                      Required="true"
                                      RequiredError="@Localizer["PasswordIsRequired"]"/>
                        <MudButton id="login-button"
                                   Class="mt-14"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   DropShadow="false"
                                   OnClick="@(() => _form.ValidateAsync())"
                                   Style="height: 45px">
                            @Localizer["LoginButton"]
                        </MudButton>
                    </MudForm>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudContainer>
</MudMainContent>

@code {
    private readonly MudTheme _theme = new();
    private bool _isDarkMode;
    private bool _success;
    private MudForm _form = null!;
    private string _password = null!;
}