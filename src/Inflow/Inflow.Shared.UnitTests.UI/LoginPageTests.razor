@using Inflow.UnitTests.UI.Common.Extensions
@inherits BunitContext

@code {
    [Fact]
    public async Task LoginPage_Should_Render_With_ThemeSwitcher_And_LoginForm()
    {
        // Arrange
        Services.AddMudServices();
        JSInterop.SetupMudBlazorJsInterop();
        
        var loginPage = Render<Login>();

        // Act
        var paper = loginPage.FindComponent<MudPaper>();
        var themeSwitcherExists = paper.HasComponent<MudSwitch<bool>>();
        var loginFormExists = paper.HasComponent<MudForm>();
        
        // Assert
        paper.Should().NotBeNull();
        themeSwitcherExists.Should().BeTrue();
        loginFormExists.Should().BeTrue();

        await Services.DisposeAsync();
    }
    
    [Fact]
    public async Task IsDarkMode_IsApplied_When_Switcher_Is_Toggled()
    {
        // Arrange
        Services.AddMudServices();
        JSInterop.SetupMudBlazorJsInterop();
        
        var loginPage = Render<Login>();
        var themeSwitcher = loginPage.Find("#theme-switcher");
            
        // Act
        await themeSwitcher.ChangeAsync(true);
        
        // Assert
        loginPage.FindComponent<MudThemeProvider>().Instance.IsDarkMode.Should().BeTrue();
        
        await Services.DisposeAsync();
    }
}